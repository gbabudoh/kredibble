# Copy to .env and fill in. Never commit .env.

# Required when DEBUG=false. Generate:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

DEBUG=false

# JSON list of browser origins allowed to call the API.
ALLOWED_ORIGINS=["http://localhost:8000"]

# JSON map of users. Create hashes with (from backend/):
#   python -m app.security hash-password
KREDIBBLE_USERS={"admin@yourcompany.com": {"password_hash": "pbkdf2_sha256$600000$...", "workgroup": "Executive"}}

# --- User accounts -----------------------------------------------------------
# PostgreSQL database for accounts (identity and plan only; chats never reach the server).
# Leave empty to run without accounts. After setting it, create the tables (from backend/):
#   alembic upgrade head
DATABASE_URL=postgresql+psycopg://kredibble:CHANGE_ME@localhost:5432/kredibble

# Public address of the site, used in email links. No trailing slash.
PUBLIC_BASE_URL=http://localhost:8000

# Outgoing email for verification and password reset (your VPS mail server).
# Leave SMTP_HOST empty to print emails to the server log instead (local development).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Port 587: SMTP_STARTTLS=true, SMTP_SSL=false. Port 465: SMTP_STARTTLS=false, SMTP_SSL=true.
SMTP_STARTTLS=true
SMTP_SSL=false
MAIL_FROM=Kredibble <no-reply@yourdomain.com>

# Max size for the optional server-side /api/v1/docs/parse endpoint.
MAX_UPLOAD_BYTES=26214400

# Self-hosted models (see DEPLOYMENT.md section 5). Path to the folder written by
# frontend/scripts/fetch-models.mjs; leave empty to download from Hugging Face.
MODELS_DIR=
# Model download hosts allowed by the Content Security Policy. Use [] when self-hosting.
# MODEL_SOURCES=[]

# Anonymous metrics (opt-in by users). Set false to refuse all events.
METRICS_ENABLED=true
